---
Language: Cpp
BasedOnStyle: WebKit
# The fork keeps upstream's formatting: no column limit and right-aligned
# pointers. Enforcing a limit here would reformat whole upstream files on
# first touch and make manual pulls of upstream security fixes painful.
ColumnLimit: 0
IndentWidth: 4
TabWidth: 4
UseTab: Never
AccessModifierOffset: -4
BreakBeforeBraces: Custom
BraceWrapping:
  AfterClass: true
  AfterControlStatement: false
  AfterFunction: true
  AfterNamespace: false
  AfterStruct: true
  AfterEnum: true
  BeforeCatch: false
  BeforeElse: false
  SplitEmptyFunction: true
AlignAfterOpenBracket: Align
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: false
PointerAlignment: Right
SortIncludes: false
Cpp11BracedListStyle: true
